            <div className=${`p-5 border rounded-sm shadow-sm flex items-start gap-4 transition-all ${canUsurp ? 'bg-rose-50 border-rose-200 hover:shadow-md' : 'bg-stone-50 border-stone-200 opacity-70'}`}>
                <div className=${`p-3 rounded-sm ${canUsurp ? 'bg-rose-200 text-rose-800' : 'bg-stone-200 text-stone-500'}`}><${Crown} className="w-8 h-8" /></div>
                <div className="flex-1">
                    <h4 className=${`font-bold text-lg mb-1 ${canUsurp ? 'text-rose-900' : 'text-stone-700'}`}>é‚‡çŸ©ãƒ»ç¸ºï½¸é¨¾ï½²éœ†é˜ªï¼ ç¸²âˆåµœè³ï½¶ç¹§å®šï½»ï½¢éš•ãƒ»ï¼†ç¸ºå¸™ï½‹</h4>
                    <p className="text-sm text-stone-600 mb-3 leading-relaxed">
                        è¨ï½§è›Ÿå ¤å™ªç¸ºï½ªè±ï½¦èœ‰å¸™â†’è¬”ï½ªèœ·é˜ªï½’ç¹§ã‚…â–²ç¸ºï½¦ç¸²âˆ«æ¨Ÿè´ç˜å®›ç¹§å‘ˆé è›Ÿåµï¼ ç¸ºï½¾ç¸ºå¶Â€ã‚‡ï½¤ï½±è¬¨åŠ±â˜†ç¹§å¾Œãƒ»è±ï½»é„‚ï½ªç¸ºï½§ç¸ºå¶Â€ãƒ»br />
                        <span className="text-xs font-bold mt-1 inline-block">ç¸²å…ˆæ“…è‰ï½¶ç¸²é¡Œï½»å ºï½ºåŒºå©¿é©¥ãƒ»0%è‰ï½¥è³ãƒ»/ è¬”ï½ªèœ·ãƒ»0è‰ï½¥è³ãƒ»/ è¬—ï½¨è³å£½å§¶èœ‰ãƒ»000è‰ï½¥è³ãƒ»/span>
                    </p>
                    <button
                        onClick=${usurpThrone}
                        disabled=${!canUsurp}
                        className=${`px-4 py-2 rounded-sm font-bold text-sm transition-all shadow-sm ${canUsurp ? 'bg-rose-700 hover:bg-rose-600 text-white animate-pulse active:scale-95' : 'bg-stone-300 text-stone-500 cursor-not-allowed'}`}
                    >
                        ${canUsurp ? `é¨¾ï½²éœ†é˜ªï½’é«¢å¥ï½§ä¹â˜†ç¹§ãƒ»(èœæ™‰ï½®ãƒ» ${Math.min(95, Math.floor((currentGuildPower / 2000) * 100))}%)` : 'è­šï½¡è‰ï½¶ç¹§å‘ˆï½ºÂ€ç¸ºæº˜ï¼ ç¸ºï½¦ç¸ºãƒ»âˆªç¸ºå¸™ï½“'}
                    </button>
                </div>
