                                    </div>
                                    <button
                                        onClick=${() => {
                                            hireReceptionist(selectedCandidate);
                                            setSelectedCandidate(null);
                                        }}
                                        className="w-full bg-indigo-700 hover:bg-indigo-600 text-white py-2 rounded-sm font-bold transition-colors shadow-sm active:scale-95"
                                    >
                                        è¬—ï½¡é€•ï½¨ç¸ºå¶ï½‹
                                    </button>
                                </div>
                            `}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    `;
}
