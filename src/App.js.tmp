                        <p className="text-sm text-stone-700 leading-relaxed bg-white p-3 rounded-sm border border-[#E8E0D5] italic shadow-sm">${selectedAdv.flavor}</p>
                    </div>
                    
                    <div className="grid grid-cols-2 gap-3">
