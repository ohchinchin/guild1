                                <div>
                                    <div className="font-bold text-stone-700 flex items-center gap-2">
                                        ${rival.name}
                                        <span className="text-xs font-normal text-stone-500">(è¬Œï½¦èœ‰ãƒ» ${rival.power} / èœ¿å¥ï½¥ï½½è ï½¦: <span className=${rival.relation >= 80 ? 'text-emerald-600 font-bold' : rival.relation >= 40 ? 'text-amber-600 font-bold' : 'text-rose-600 font-bold'}>${rival.relation}</span>)</span>
                                    </div>
