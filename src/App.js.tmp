import htm from 'https://unpkg.com/htm?module';
const React = window.React;
const html = htm.bind(React.createElement);
export default function AlignmentView({ gameState, updateAlignment }) {
    const { Shield, Map: MapIcon, Swords, Beer } = window.LucideReact || window.lucide || {};
    if (!Shield) return null;

    return html`
        <div className="space-y-6 animate-in fade-in slide-in-from-right-4 duration-500">
            <p className="text-stone-600 mb-4">ç¹§ï½®ç¹ï½«ç¹å³¨ãƒ»è­ï½¹èœ·ç¬¬Â€ï½§ç¹§å‘ˆï½±ï½ºè³å£¹ï¼ ç¸ºï½¾ç¸ºå¶Â€ã‚…ï¼…ç¸ºï½®è±ˆçš®ç´«ç¸ºï½«è ¢æ‡ŠÂ§ç¸ºï½¦ç¸²âˆ¬ãƒ»èœæ…•ï½·ï½¨è¬ŒèˆŒï¼†ç¹§å¾Œï½‹é©›ï½¨é««ç¿«â€²èœ·ä»£Â°ç¸ºãƒ»ï½»ï½»èœå¶ãƒ»é’ï½ºé‚‡ãƒ»â€²èŸç‰™å–§ç¸ºåŠ±âˆªç¸ºå¶Â€ãƒ»/p>
            <div className="grid grid-cols-1 xl:grid-cols-2 gap-6">
                <div className="bg-white p-5 border border-[#E8E0D5] rounded-sm shadow-sm space-y-6">
                    ${[
                        { id: 'safety', label: 'é™¦åŠ±ãƒ»è±ï½»è³è‡¥ï½¶ï½­è¬–ãƒ», icon: Shield, color: 'text-emerald-700' },
                        { id: 'adventure', label: 'è­›ï½ªé«¢ä¹ãƒ»è¨ï½°ç¸ºï½®è¬—ï½¢é‚ï½¢', icon: MapIcon, color: 'text-indigo-700' },
                        { id: 'military', label: 'è‰å¤œï£°å€¥âˆˆç¸ºï½®éœ†å ºï½ºå€¶ï½¾ï½µè¬¾ï½»', icon: Swords, color: 'text-rose-800' },
                        { id: 'commerce', label: 'è ãƒ»ï½¥ï½­ç¸ºï½¨èœ€ãƒ»å¸†', icon: Beer, color: 'text-amber-600' }
                    ].map(item => {
                        const ItemIcon = item.icon;
                        return html`
