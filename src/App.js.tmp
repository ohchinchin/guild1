                                    <div className="text-amber-600">è£ï½±é©Ÿï½¬: ${q.reward}G</div>
                                    ${q.deposit > 0 && html`<div className="text-emerald-600 col-span-2">èœ‘åŸ¼â‰¡èœ¿éˆ´ï£°ä¼œåº„: ${q.deposit}G</div>`}
                                </div>
                                <button 
