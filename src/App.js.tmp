                                <div>
                                    ${!status && html`
                                        <button onClick=${() => requestAlliance(rival.id)} className="bg-indigo-700 hover:bg-indigo-600 text-white px-4 py-2 rounded-sm text-sm font-bold transition-colors shadow-sm active:scale-95">
                                            è´ï½¿é– ãƒ»ï½’é¨¾âˆšï½‹
