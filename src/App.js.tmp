}
import htm from 'https://unpkg.com/htm?module';
const React = window.React;
const html = htm.bind(React.createElement);
import TypewriterText from './TypewriterText.js';

export default function EndingView({ gameState, quarterResult, resetGame }) {
    const { Crown } = window.LucideReact || window.lucide || {};
    if (!gameState.gameOver || quarterResult) return null;

    let title = "", desc = "", colorClass = "text-amber-500", bgClass = "bg-[#2A241F]", borderClass = "border-[#D4C3A3]";

    if (gameState.endType === "SELL") {
        title = "è¨æ™ï½ªï½¬ç¸ºï½®è ãƒ»ï½ºï½º";
        desc = `ç¸ºã‚…â†‘ç¸ºæº˜ãƒ»è®“ï½©è›»ï½©è­–ï½¸ç¹§ãƒ»${gameState.endData.toLocaleString()} G ç¸ºï½§èŸ¾ï½¨èŸï½§è ãƒ»ï½¼å£¹â†“è¢ï½²èœŠï½´ç¸ºåŠ±âˆªç¸ºåŠ±â—†ç¸²ã‚Šï½¡Â€ç¸ºï½¿ç¸ºï½©ç¹§é˜ªãƒ»è¬Œï½¦è£ï½´ç¸ºä¹ï½‰éœ„ï½«ç¹§å¸Â€Â€ç¸ºé˜ªÂ€âˆ¬è¾èŸï½§ç¸ºï½ªèŸ‡å¾Œâ†’èœˆï½±ç¸ºï½«èœ†ï½ªé«®ãƒ»â†‘è´å’å‡½ç¹§å¸Â€âˆšï½Šç¸ºï½¾ç¸ºå¶Â€ã‚Šï½¦å€¶ï½ºä¹â†‘è¬‡ç–ãƒ»ç¸ºï½§ç¸ºåŠ±â—†ç¸²ï¼¡;
    } else if (gameState.endType === "TIME_UP") {
        title = "è³ç‰™é¦™èŸ·ï½´ç¸ºï½®èœ¿å©ï½ºç–ï½©ï½©";
        desc = `30èŸ·ï½´ç¸ºï½®èœãƒ»ï½¨ï½±è­›æ»„ä¿£ç¸ºæªï½µã‚†ï½ºãƒ»ï¼ ç¸ºï½¾ç¸ºåŠ±â—†ç¸²ã‚ˆæ€™é‚¨ã‚‹â‰¡è ï½«: ${gameState.budget.toLocaleString()}G | èœ·æ¦Šï½£ï½°: ${gameState.fame} | è¬”ï½ªèœ·ãƒ» ${gameState.notoriety}ç¸²ã‚…â‰ ç¸ºï½ªç¸ºæº˜ãƒ»é½å³¨â€³è³ç¿«ï¿¡ç¸ºæº˜ãç¹ï½«ç¹å³¨ãƒ»ç¸²âˆæ¾„é©•é¡˜ï½©ï½©è ï½ºç¸ºï½«ç¹§åŒ»â–²ç¸ºï½¦é«Ÿï½·ç¸ºå‰°ï½ªæ§­ï½Šé‚¯å¶â€²ç¹§å¾Œï½‹ç¸ºï½§ç¸ºåŠ±ï½‡ç¸ºãƒ»Â€ï¼¡;
    } else if (gameState.endType === "BANKRUPT") {
        title = "èŸ¾ï½¨é¬˜é˜ªãƒ»é›‹ï£°è›¯ï½µ"; colorClass = "text-rose-600";
        desc = `èœ¿æ‚¶ï½Šé¶ä¹â€»è»ä¹â€²ç¹§ï½®ç¹ï½«ç¹å³¨ï½’è›¹ãƒ»å³‡ç¸ºåŠ±âˆªç¸ºåŠ±â—†ç¸²ã‚‡ãƒ»é›‰ãƒ»è‚‡ç¸ºï½¯èŸ¾ï½®ç¸ºç²æ¬¾ç¸ºè¼”âˆ´ç¹§å³¨ï½Œç¸²âˆšâ‰ ç¸ºï½ªç¸ºæº˜ãƒ»é¯è¬ï½¸Â€ç¸ºï½¤ç¸ºï½ªç¸ºãƒ»ã—èœå‘µÂ€ãƒ»å±®è¿¯ãƒ»ãƒ»èœ€ï½·ç¸ºæº˜ï¼éï½³è ç¿«ãƒ»è³ç¿«ã€’è´å’å‡½ç¹§å¸â„ƒç¸ºæ–â˜†ç¸ºè–™â†’ç¸ºï½«ç¸ºï½ªç¹§ç¿«âˆªç¸ºå¶Â€ï¼¡;
    } else if (gameState.endType === "RUIN") {
        title = "é«±åï½¯ã‚…ãƒ»è ãƒ»ä¿£"; colorClass = "text-stone-400";
        desc = `èœ€å¸åŒ±é– ãƒ»ãƒ»èŸ‹ï½¿ç¸ºï½¯ç¸ºï½ªç¸ºä¸ŠÂ€ãƒ»â‰¡è ï½«ç¸ºï½®è è¼”ï½‚éš•ä¹âˆ´ç¸ºï½¾ç¸ºåŠ±â—†ç¸²ã‚…ãç¹ï½«ç¹å³¨ãƒ»è¬‡å³¨â†“ç¸ºï½¯è­šï½¿ç¸ºæ¢§é ç¸ºï½¡è‰å€¥ï¿ ç¹§å³¨ï½Œç¸²âˆšâ‰ ç¸ºï½ªç¸ºæº˜ãƒ»èŸï½±è¬¨åŠ±ï¼ ç¸ºæº¯ï½¨ï½­é¶ç–Â€ãƒ»â†’ç¸ºåŠ±â€»è±ï½´èœ¿ï½²ç¸ºï½®é«£ãƒ»âˆˆç¸ºï½¨è±¸åŒ»âˆ´ç¸ºï½¦ç¸ºãƒ»â€³ç¸ºï½¾ç¸ºå¶Â€ï¼¡;
    } else if (gameState.endType === "USURP_WIN") {
        title = "é‚‡ç‰™ï½ºï½§ç¸ºï½®é‚è²ï½¥ï½ªé– ãƒ»; colorClass = "text-purple-500";
        desc = `ç¸ºã‚…â†‘ç¸ºæº˜ãƒ»é©›ï½¨é««ç¿«ãƒ»é‚‡çŸ©ãƒ»ç¹§å®šï½¹ã‚Šï½ºå¶ï¼ ç¸²âˆ«è„‚è ï½§ç¹§å®šï½¡Â€ç¸ºï½§è­Ÿè–™ï½è³ç¿«ï¿¡ç¸ºï½¾ç¸ºåŠ±â—†ç¸²ã‚…ãç¹ï½«ç¹å³¨â€²è±•è¼”â†’ç¸ºï½ªç¹§ç¿«Â€âˆšâ‰ ç¸ºï½ªç¸ºæº˜â€²é‚¨ï½¶èŸ‡ï½¾é€§ãƒ»â†‘éš•ãƒ»è¦–ç¸ºï½¨ç¸ºï½ªç¹§ä¹Â€âˆµçœ ç¸ºæº˜â†‘ç¹§åŒºå›“é®Ÿå‘ˆå‡¾è‰ï½£ç¸ºï½®èŸ·æš®å¹•ç¸ºä»£ã€’ç¸ºå¶Â€ï¼¡;
    } else if (gameState.endType === "USURP_LOSE") {
        title = "èœ¿åŸ¼Â€ãƒ»Â€ãƒ»ãƒ»è­›ï½«éœï½¯"; colorClass = "text-rose-600";
        desc = `é‚‡å¥åµœç¸ºï½®é‚Šï½¾é©ªï½­é¬¨ä¸»ï½£ï½«è—ï½£ç¸ºï½®èœ‘é˜ªâ†“ç¸²ãƒ»Îšé««ç¿«ãƒ»è¾Ÿï½¡è°¿ä¹â†“è¬¨ï½£ç¹§ç¿«âˆªç¸ºåŠ±â—†ç¸²ã‚…ãç¹ï½«ç¹å³¨ãƒ»ç¹§ï½¹ç¹§ï½¿ç¹ï½¼ç¸ºï½§ç¸ºã‚…ï½‹ç¸ºã‚…â†‘ç¸ºæº˜â†’èœ·ç‘šãƒ»ç¸ºæº˜â– ç¸ºï½¯ç¸²âˆ½ï½¸ï½­èŸï½®è ãƒ»ï£°ï½´ç¸ºï½§é„’ï½¤é™¦ãƒ»ãƒ»èŒï½²éš¨ä»£ï½’è±¬ï½´ç¸ºï½³ç¸ºï½ªç¸ºå¾Œï½‰è­ï½­é¬†ï½­èœ¿ï½°ç¸ºï½®é«´ï½²ç¸ºï½¨è±¸åŒ»âˆ´ç¸ºï½¾ç¸ºåŠ±â—†ç¸²ï¼¡;
    }

    return html`
        <div className="fixed inset-0 bg-black/90 flex items-center justify-center z-50 p-4 font-serif">
